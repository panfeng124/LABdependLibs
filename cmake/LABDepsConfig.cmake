# Relocatable entrypoint for packages produced by LABdependLibs/build.ps1.
cmake_minimum_required(VERSION 3.22)
get_property(_lab_previous GLOBAL PROPERTY LABDEPS_ACTIVE_PREFIX)
if(_lab_previous AND NOT _lab_previous STREQUAL CMAKE_CURRENT_LIST_DIR)
    message(FATAL_ERROR "Cannot mix two LAB dependency profiles in one build")
endif()
set_property(GLOBAL PROPERTY LABDEPS_ACTIVE_PREFIX "${CMAKE_CURRENT_LIST_DIR}")
set(LABDeps_FOUND TRUE)
set(LABDEPS_RUNTIME_DIRS "")
set(_lab_names zlib brotli libpng freetype harfbuzz glfw glm libhv lunasvg nfd openal yoga assimp sqlite3 libffi)
if(NOT TARGET LAB::all)
    add_library(LAB::all INTERFACE IMPORTED)
endif()
foreach(_name IN LISTS _lab_names)
    set(_prefix "${CMAKE_CURRENT_LIST_DIR}/${_name}")
    if(NOT EXISTS "${_prefix}/build-info.json")
        set(LABDeps_${_name}_FOUND FALSE)
        continue()
    endif()
    file(READ "${_prefix}/build-info.json" _info)
    string(JSON _profile GET "${_info}" profile)
    string(JSON _config GET "${_info}" configuration)
    if(DEFINED LABDEPS_PROFILE AND NOT LABDEPS_PROFILE STREQUAL _profile)
        message(FATAL_ERROR "Mixed LAB dependency toolchains")
    endif()
    if(DEFINED LABDEPS_CONFIGURATION AND NOT LABDEPS_CONFIGURATION STREQUAL _config)
        message(FATAL_ERROR "Mixed LAB dependency configurations")
    endif()
    set(LABDEPS_PROFILE "${_profile}")
    set(LABDEPS_CONFIGURATION "${_config}")
    if(CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL _config)
        message(FATAL_ERROR "LAB package is ${_config}, consumer is ${CMAKE_BUILD_TYPE}")
    endif()
    if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "This LAB package requires a 64-bit consumer")
    endif()
    if(CMAKE_VS_PLATFORM_NAME AND NOT CMAKE_VS_PLATFORM_NAME STREQUAL "x64")
        message(FATAL_ERROR "This LAB package requires an x64 consumer")
    endif()
    set(LABDeps_${_name}_FOUND TRUE)
    if(TARGET LAB::${_name})
        continue()
    endif()
    add_library(LAB::${_name} INTERFACE IMPORTED)
    set(_includes "${_prefix}/include")
    foreach(_suffix freetype2 harfbuzz hv lunasvg plutovg AL)
        if(IS_DIRECTORY "${_prefix}/include/${_suffix}")
            list(APPEND _includes "${_prefix}/include/${_suffix}")
        endif()
    endforeach()
    set_property(TARGET LAB::${_name} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_includes}")
    # Only the small, installed lib directory is enumerated.
    file(GLOB _libs "${_prefix}/lib/*.lib")
    if(NOT _name STREQUAL "glm" AND NOT _libs)
        message(FATAL_ERROR "No import/static libraries installed for ${_name}")
    endif()
    set_property(TARGET LAB::${_name} PROPERTY INTERFACE_LINK_LIBRARIES "${_libs}")
    string(JSON _count LENGTH "${_info}" dependencies)
    if(_count GREATER 0)
        math(EXPR _last "${_count}-1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _dependency GET "${_info}" dependencies ${_index})
            if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/${_dependency}/build-info.json")
                message(FATAL_ERROR "${_name} requires missing package ${_dependency}")
            endif()
            set_property(TARGET LAB::${_name} APPEND PROPERTY INTERFACE_LINK_LIBRARIES LAB::${_dependency})
        endforeach()
    endif()
    set_property(TARGET LAB::all APPEND PROPERTY INTERFACE_LINK_LIBRARIES LAB::${_name})
endforeach()
# Gather runtime paths even when find_package is called repeatedly.
foreach(_name IN LISTS _lab_names)
    if(IS_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/${_name}/bin")
        list(APPEND LABDEPS_RUNTIME_DIRS "${CMAKE_CURRENT_LIST_DIR}/${_name}/bin")
    endif()
endforeach()
if(TARGET LAB::glfw)
    set_property(TARGET LAB::glfw PROPERTY INTERFACE_COMPILE_DEFINITIONS GLFW_DLL)
endif()
if(TARGET LAB::brotli)
    set_property(TARGET LAB::brotli PROPERTY INTERFACE_COMPILE_DEFINITIONS BROTLI_SHARED_COMPILATION)
endif()
foreach(_component IN LISTS LABDeps_FIND_COMPONENTS)
    if(NOT LABDeps_${_component}_FOUND)
        set(LABDeps_FOUND FALSE)
        set(LABDeps_NOT_FOUND_MESSAGE "Missing LAB dependency: ${_component}")
    endif()
endforeach()

function(lab_deps_copy_runtime target)
    foreach(_dir IN LISTS LABDEPS_RUNTIME_DIRS)
        file(GLOB _dlls "${_dir}/*.dll")
        foreach(_dll IN LISTS _dlls)
            add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E
                copy_if_different "${_dll}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
        endforeach()
    endforeach()
endfunction()
